// sdk_workflow.kinet — Script agent "đời thực" (Giai đoạn A)
//
// Đọc danh sách task từ file → chạy agent Kinetic SDK thật cho từng task →
// gom kết quả vào list các map → ghi báo cáo ra file.
// Minh họa cách dùng: dict literal {...}, list/string helpers, agent_run,
// read_file/write_file trong một luồng việc thực tế.

let tasks_file = "/tmp/kinet_tasks.txt";
let report_file = "/tmp/kinet_report.txt";

// 1) Giả lập một file việc cần làm
write_file(tasks_file, "Sửa lỗi #42\nKiểm tra hiệu năng API\nViết test cho module X");

// 2) Đọc + chia task
let tasks = split(read_file(tasks_file), "\n");
println("Đọc được ", len(tasks), " task cần xử lý:");

// 3) Chạy agent cho từng task, gom kết quả thành list các map
let results = [];
for t in tasks {
    if len(t) == 0 {
        continue;
    }
    let out = agent_run(t);                  // gọi Kinetic SDK thật
    let ok = starts_with(out, "goal complete");
    let mark = match ok {
        case true => "✅";
        case false => "⚠️";
    };
    results = append(results, { "task": t, "output": out, "ok": ok });
    println("  ", mark, " [", substring(t, 0, 20), "] → ", substring(out, 0, 40));
}

// 4) Ghi báo cáo ra file
let lines = [];
lines = append(lines, "BÁO CÁO KINET — xử lý " + to_int("" + len(results)) + " task");
for r in results {
    lines = append(lines, "- " + get(r, "task") + " : " + substring(get(r, "output"), 0, 60));
}
write_file(report_file, list_join(lines, "\n"));

println("");
println("Đã ghi báo cáo vào ", report_file);
println(read_file(report_file));