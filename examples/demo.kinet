// Chương trình demo cho Kinet
// Tính giai thừa bằng đệ quy + số Fibonacci

func factorial(n) {
    if n <= 1 {
        return 1;
    }
    return n * factorial(n - 1);
}

func fibonacci(n) {
    if n < 2 {
        return n;
    }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

println("factorial(5) = ", factorial(5));
println("fibonacci(10) = ", fibonacci(10));

// Vòng lặp while tính tổng 1..10
let total = 0;
let i = 1;
while i <= 10 {
    total = total + i;
    i = i + 1;
}
println("tong 1..10 = ", total);

// Biến chuỗi + nối kiểu
let name = "An";
println("Chao ", name, "!", " 2 + 3 = ", 2 + 3);